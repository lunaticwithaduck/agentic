# Secrets and credentials
.env
.env.*
*.pem
*.key
credentials.json

# OS
.DS_Store
Thumbs.db

# Common language artifacts
node_modules/
__pycache__/
*.pyc
.venv/
venv/
target/
dist/
build/
*.o
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local Claude overrides (keep settings.local.json for personal config)
# .claude/settings.local.json

# Bench: raw JSON metrics (machine-readable, regenerable — .md files ARE tracked)
bench/results/metrics/*.json

# Bench e2e: cached API responses and judgements (expensive to regenerate)
# Commit these intentionally if you want to preserve a run baseline
bench/results/e2e/

# Autolearn runtime state (regenerable, machine-specific)
.claude/skill-usage.json
.claude/autolearn-pending
.claude/scheduled_tasks.lock

# Sandbox projects (local experiments, not part of the repo)
temp/
experiments/*
